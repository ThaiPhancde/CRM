// CRM LevelUp — schema. Quy ước (docs/data-model.md):
// - Bảng nghiệp vụ có workspaceId; lớp src/lib/db.ts tự lọc/gán theo workspace (D-03). Membership có workspaceId
//   nhưng là bảng phân quyền toàn hệ thống, tra trước khi có ngữ cảnh → không lọc.
// - Workspace = team/đơn vị kinh doanh (D-29). Tiền Decimal (D-09).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Vai trò cố định, ma trận quyền ở src/lib/permissions.ts (D-21, D-32).
enum Role {
  MANAGER
  SALES_LEAD
  SALES
  MARKETING
  FULFILLMENT
  PURCHASING_VIEW
  FINANCE_VIEW
}

enum PaymentMode {
  PREPAID
  COD
}

model Workspace {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  memberships Membership[]
  teams       Team[]
  brands      Brand[]
  markets     Market[]
  stores      Store[]
  fxRates     FxRate[]
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String
  /// Quản trị công ty LevelUp: vào mọi workspace; ở workspace không có membership thì mang quyền Quản lý (D-29).
  isCompanyAdmin Boolean        @default(false)
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  memberships    Membership[]
  ownedLeads     Lead[]         @relation("LeadOwner")
  tasks          Task[]         @relation("TaskAssignee")
  activities     Activity[]
  notifications  Notification[]
  ownedTickets   Ticket[]       @relation("TicketOwner")
  agentRuns      AgentRun[]
}

model Membership {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  roles       Role[]
  teamId      String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  team        Team?     @relation(fields: [teamId], references: [id])

  @@unique([workspaceId, userId])
  @@index([teamId])
}

model Team {
  id          String       @id @default(cuid())
  workspaceId String
  code        String
  name        String
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workspace   Workspace    @relation(fields: [workspaceId], references: [id])
  members     Membership[]
  leads       Lead[]

  @@unique([workspaceId, code])
}

model Brand {
  id          String    @id @default(cuid())
  workspaceId String
  code        String
  name        String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  stores      Store[]
  products    Product[]
  leads       Lead[]
  scripts     Script[]

  campaigns Campaign[]

  @@unique([workspaceId, code])
}

model Market {
  id          String      @id @default(cuid())
  workspaceId String
  /// Mã quốc gia ISO 3166-1 alpha-2 (US, DE, AE…)
  code        String
  name        String
  currency    String
  paymentMode PaymentMode
  timezone    String
  locale      String
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  stores      Store[]
  orders      Order[]
  customers   Customer[]
  leads       Lead[]
  scripts     Script[]

  @@unique([workspaceId, code])
}

model Store {
  id          String       @id @default(cuid())
  workspaceId String
  brandId     String
  code        String
  name        String
  /// Mã adapter đăng ký (pancake, shopify, website…) — chuỗi, không enum, để thêm nền tảng không đổi schema (D-28).
  platform    String
  externalId  String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workspace   Workspace    @relation(fields: [workspaceId], references: [id])
  brand       Brand        @relation(fields: [brandId], references: [id])
  markets     Market[]
  connections Connection[]
  orders      Order[]

  @@unique([workspaceId, code])
}

model FxRate {
  id          String    @id @default(cuid())
  workspaceId String
  currency    String
  /// 1 đơn vị tiền này = rateToBase đơn vị tiền quy đổi chung (BASE_CURRENCY = VND, D-44)
  rateToBase  Decimal   @db.Decimal(18, 8)
  validFrom   DateTime  @db.Date
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, currency, validFrom])
}

/// Nhật ký chỉ thêm (D-16): không cập nhật, không xóa.
model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String
  entity      String
  entityId    String
  action      String
  before      Json?
  after       Json?
  reason      String?
  at          DateTime @default(now())

  @@index([workspaceId, entity, entityId])
  @@index([workspaceId, at])
}

model IdempotencyKey {
  id          String   @id @default(cuid())
  workspaceId String
  scope       String
  key         String
  resultRef   String?
  createdAt   DateTime @default(now())

  @@unique([workspaceId, scope, key])
}

/// Cấu hình theo workspace (key/value JSON): linkRules, sourceOfTruth… (D-32). Sửa ở Quản trị → Cấu hình (Phase 11).
model Setting {
  id          String   @id @default(cuid())
  workspaceId String
  key         String
  value       Json
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, key])
}

// ---- Phase 2: kết nối dữ liệu ---------------------------------------------------------------------

enum ConnectionStatus {
  ACTIVE
  PAUSED
  ERROR
}

enum SyncMode {
  BACKFILL
  INCREMENTAL
  REPLAY
}

enum SyncStatus {
  RUNNING
  OK
  FAILED
}

enum EventOutcome {
  APPLIED
  LINKED
  STALE
  /// Nguồn mới hơn nhưng không làm chủ nhóm trường nào của đơn (D-32) — giữ mốc, không ghi đè.
  NOT_OWNER
  DUPLICATE
  ERROR
}

model Connection {
  id              String            @id @default(cuid())
  workspaceId     String
  storeId         String
  /// Mã adapter (D-28), lấy từ Store.platform lúc tạo.
  platform        String
  /// "replay" (demo, đọc fixture) hoặc "live" (API thật, Phase 12).
  mode            String            @default("replay")
  status          ConnectionStatus  @default(ACTIVE)
  /// Khóa/URL của API thật, mã hóa AES-256-GCM bằng INTEGRATION_SECRET_KEY. Replay không cần.
  configEncrypted String?
  pollIntervalMin Int               @default(15)
  lastSyncAt      DateTime?
  lastError       String?
  /// Khóa chống chạy đồng bộ chồng nhau (worker và nút "Đồng bộ ngay").
  syncLockedUntil DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  store           Store             @relation(fields: [storeId], references: [id])
  runs            SyncRun[]
  links           SourceOrderLink[]

  @@unique([workspaceId, storeId])
}

model SyncRun {
  id           String        @id @default(cuid())
  workspaceId  String
  connectionId String
  mode         SyncMode
  status       SyncStatus    @default(RUNNING)
  startedAt    DateTime      @default(now())
  finishedAt   DateTime?
  applied      Int           @default(0)
  linked       Int           @default(0)
  stale        Int           @default(0)
  notOwner     Int           @default(0)
  duplicate    Int           @default(0)
  errors       Int           @default(0)
  reviews      Int           @default(0)
  error        String?
  connection   Connection    @relation(fields: [connectionId], references: [id])
  events       SourceEvent[]

  @@index([workspaceId, connectionId, startedAt])
}

model SyncCheckpoint {
  id           String    @id @default(cuid())
  workspaceId  String
  connectionId String
  recordType   String
  cursorAt     DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([workspaceId, connectionId, recordType])
}

/// Mỗi bản ghi nguồn nhận được (kể cả trùng/cũ/lỗi) để truy vết và chạy lại. eventKey = loại:mã:sourceUpdatedAt.
model SourceEvent {
  id              String       @id @default(cuid())
  workspaceId     String
  connectionId    String
  syncRunId       String?
  eventKey        String
  recordType      String
  sourceRecordId  String
  sourceUpdatedAt DateTime
  outcome         EventOutcome
  error           String?
  /// Bản ghi gốc. Demo lưu thẳng; khi lên thật áp chính sách lưu.
  payload         Json
  orderId         String?
  createdAt       DateTime     @default(now())
  syncRun         SyncRun?     @relation(fields: [syncRunId], references: [id])

  @@unique([workspaceId, connectionId, eventKey])
  @@index([workspaceId, outcome])
  @@index([workspaceId, orderId])
}

// ---- Phase 2: sản phẩm -----------------------------------------------------------------------------

model Product {
  id          String    @id @default(cuid())
  workspaceId String
  brandId     String?
  code        String
  name        String
  nameEn      String?
  nameAr      String?
  category    String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  brand       Brand?    @relation(fields: [brandId], references: [id])
  variants    Variant[]

  @@unique([workspaceId, code])
}

model Variant {
  id           String                 @id @default(cuid())
  workspaceId  String
  productId    String
  sku          String
  attributes   Json
  costPrice    Decimal?               @db.Decimal(18, 4)
  costCurrency String?
  product      Product                @relation(fields: [productId], references: [id])
  items        OrderItem[]
  mappings     SourceProductMapping[]

  @@unique([workspaceId, sku])
  @@index([productId])
}

model SourceProductMapping {
  id           String  @id @default(cuid())
  workspaceId  String
  variantId    String
  connectionId String
  sourceSku    String
  variant      Variant @relation(fields: [variantId], references: [id])

  @@unique([workspaceId, connectionId, sourceSku])
  @@index([variantId])
}

// ---- Phase 2: đơn chuẩn (một đơn kinh doanh, nhiều liên kết nguồn — D-06, D-07) -------------------

enum OrderStatus {
  BOOKED
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
  COD_PENDING
  COD_COLLECTED
}

enum FulfillmentStatus {
  UNFULFILLED
  IN_TRANSIT
  PARTIAL
  DELIVERED
  FAILED
  RETURNED
}

enum ReturnStatus {
  NONE
  PARTIAL
  FULL
}

enum DeliveryEventType {
  PICKED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  COD_COLLECTED
}

enum ReviewStatus {
  PENDING
  LINKED
  REJECTED
}

model Order {
  id                String            @id @default(cuid())
  workspaceId       String
  storeId           String
  marketId          String?
  orderNumber       String
  status            OrderStatus
  paymentStatus     PaymentStatus
  fulfillmentStatus FulfillmentStatus
  returnStatus      ReturnStatus      @default(NONE)
  currency          String
  /// Σ dòng hàng (nguyên tệ)
  grossAmount       Decimal           @db.Decimal(18, 4)
  discount          Decimal           @db.Decimal(18, 4)
  shippingFee       Decimal           @db.Decimal(18, 4)
  /// gross − discount + shipping (nguyên tệ). REV-01/02 dùng giá trị này.
  netAmount         Decimal           @db.Decimal(18, 4)
  refundedAmount    Decimal           @default(0) @db.Decimal(18, 4)
  /// 1 đơn vị tiền đơn = fxRate VND (tiền quy đổi chung, D-44), chốt theo FxRate hiệu lực tại ngày đặt (D-09).
  fxRate            Decimal           @db.Decimal(18, 8)
  fxDate            DateTime          @db.Date
  /// Giá trị đơn quy ra tiền quy đổi chung (VND).
  netBase           Decimal           @db.Decimal(18, 4)
  /// Khách hợp nhất (Phase 3, D-08). Ảnh chụp thông tin khách từ nguồn giữ nguyên bên dưới để truy vết.
  customerId        String?
  customerName      String?
  customerPhone     String?
  customerEmail     String?
  customerSourceId  String?
  shipCountry       String?
  bookedAt          DateTime
  confirmedAt       DateTime?
  cancelledAt       DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  store             Store             @relation(fields: [storeId], references: [id])
  market            Market?           @relation(fields: [marketId], references: [id])
  items             OrderItem[]
  links             SourceOrderLink[]
  payments          Payment[]
  refunds           Refund[]
  shipments         Shipment[]
  customer          Customer?         @relation(fields: [customerId], references: [id])
  tasks             Task[]

  tickets         Ticket[]
  settlementLines SettlementLine[]
  deliveryActions DeliveryAction[]

  @@index([workspaceId, bookedAt])
  @@index([workspaceId, customerPhone])
  @@index([workspaceId, customerId])
  @@index([workspaceId, storeId, bookedAt])
  @@index([workspaceId, marketId, bookedAt])
  @@index([orderNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Order_orderNumber_trgm_idx")
  @@index([customerName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Order_customerName_trgm_idx")
  @@index([customerPhone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Order_customerPhone_trgm_idx")
  @@index([customerEmail(ops: raw("gin_trgm_ops"))], type: Gin, map: "Order_customerEmail_trgm_idx")
  @@index([workspaceId, deliveredAt])
  @@index([workspaceId, confirmedAt])
}

// ---- Phase 3: Customer 360 (D-08) -----------------------------------------------------------------

enum ContactChannel {
  EMAIL
  SMS
  PHONE
  WHATSAPP
  MESSENGER
}

enum ContactPurpose {
  MARKETING
  SERVICE
}

enum AddressKind {
  SHIPPING
  BILLING
}

/// Hồ sơ khách hợp nhất trong một workspace (không chia sẻ giữa workspace — HLD §6.1).
model Customer {
  id               String              @id @default(cuid())
  workspaceId      String
  displayName      String
  primaryPhoneE164 String?
  primaryEmail     String?
  locale           String?
  marketId         String?
  /// Tổng hợp từ đơn, cập nhật khi gắn đơn (để lọc/sắp nhanh). Giá trị tiền tính ở service theo quyền.
  orderCount       Int                 @default(0)
  firstOrderAt     DateTime?
  lastOrderAt      DateTime?
  /// REV-03 (giá trị giao thành công − hoàn) 12 tháng gần nhất, quy ra VND (D-44). Tính lại khi gắn đơn và hằng ngày (worker); Phase 6 thay bằng Warehouse.
  valueBase12m     Decimal             @default(0) @db.Decimal(18, 4)
  deliveredOrders  Int                 @default(0)
  statsAt          DateTime?
  tags             String[]
  /// Đã bị gộp vào khách khác (giữ dòng để tách lại; ẩn khỏi danh sách).
  mergedIntoId     String?
  /// Đã xóa dữ liệu cá nhân theo yêu cầu (Phase 11, ẩn danh hóa — giữ đơn/số tiền cho chỉ số).
  erasedAt         DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  market           Market?             @relation(fields: [marketId], references: [id])
  identities       CustomerIdentity[]
  addresses        Address[]
  preferences      ContactPreference[]
  orders           Order[]
  leads            Lead[]
  activities       Activity[]
  tasks            Task[]

  tickets Ticket[]

  metrics        CustomerMetric[]
  scores         Score[]
  segmentMembers SegmentMember[]
  journeyRuns    JourneyRun[]
  touchpoints    Touchpoint[]

  @@index([workspaceId, primaryPhoneE164])
  @@index([workspaceId, lastOrderAt])
  @@index([workspaceId, marketId])
  @@index([workspaceId, valueBase12m])
  @@index([workspaceId, orderCount])
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_displayName_trgm_idx")
}

/// Một mã khách ở một nguồn (hoặc một SĐT/email thấy trong đơn). Bằng chứng để gộp.
model CustomerIdentity {
  id               String    @id @default(cuid())
  workspaceId      String
  customerId       String
  platform         String
  connectionId     String?
  sourceCustomerId String?
  phoneE164        String?
  emailNormalized  String?
  emailVerified    Boolean   @default(false)
  sourceUpdatedAt  DateTime?
  createdAt        DateTime  @default(now())
  customer         Customer  @relation(fields: [customerId], references: [id])

  @@unique([workspaceId, connectionId, sourceCustomerId])
  @@index([workspaceId, phoneE164])
  @@index([workspaceId, emailNormalized])
  @@index([customerId])
  @@index([phoneE164(ops: raw("gin_trgm_ops"))], type: Gin, map: "CustomerIdentity_phoneE164_trgm_idx")
}

model Address {
  id          String      @id @default(cuid())
  workspaceId String
  customerId  String
  kind        AddressKind
  /// Bản gốc từ nguồn
  raw         Json
  /// Kết quả chuẩn hóa (demo: quốc gia + chuỗi gọn)
  normalized  Json?
  countryCode String?
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  customer    Customer    @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

/// Quyền liên hệ theo kênh × mục đích × brand, có lịch sử (mỗi thay đổi một dòng mới — HLD §6.2).
model ContactPreference {
  id          String         @id @default(cuid())
  workspaceId String
  customerId  String
  channel     ContactChannel
  purpose     ContactPurpose
  brandId     String?
  optIn       Boolean
  source      String
  changedById String?
  changedAt   DateTime       @default(now())
  customer    Customer       @relation(fields: [customerId], references: [id])

  @@index([workspaceId, customerId, channel, purpose])
}

/// Hai khách nghi là một người nhưng chưa đủ bằng chứng tự gộp (ví dụ chỉ trùng email chưa xác minh) → /xac-minh tab Khách.
model CustomerReview {
  id          String       @id @default(cuid())
  workspaceId String
  customerAId String
  customerBId String
  reasons     Json
  status      ReviewStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime     @default(now())

  @@unique([workspaceId, customerAId, customerBId])
}

model OrderItem {
  id           String   @id @default(cuid())
  workspaceId  String
  orderId      String
  variantId    String?
  sourceSku    String
  name         String
  qty          Int
  qtyDelivered Int      @default(0)
  qtyReturned  Int      @default(0)
  unitPrice    Decimal  @db.Decimal(18, 4)
  lineAmount   Decimal  @db.Decimal(18, 4)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant      Variant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([workspaceId, variantId])
}

model SourceOrderLink {
  id              String     @id @default(cuid())
  workspaceId     String
  orderId         String
  connectionId    String
  platform        String
  sourceRecordId  String
  /// Mã đơn hiển thị ở nguồn, đã chuẩn hóa (bỏ #, khoảng trắng, chữ thường) để so quy tắc liên kết.
  orderNumberNorm String
  /// Mã tham chiếu tới đơn ở nguồn khác (đã chuẩn hóa), mapper trích từ ghi chú/tag.
  refs            String[]
  sourceStatusRaw String
  sourceUpdatedAt DateTime
  /// Liên kết tạo đơn (nguồn đầu tiên). Mặc định chủ mọi nhóm trường (D-32).
  isPrimary       Boolean    @default(false)
  createdAt       DateTime   @default(now())
  order           Order      @relation(fields: [orderId], references: [id])
  connection      Connection @relation(fields: [connectionId], references: [id])

  @@unique([workspaceId, connectionId, sourceRecordId])
  @@index([workspaceId, platform, orderNumberNorm])
  @@index([orderId])
}

model OrderLinkReview {
  id          String       @id @default(cuid())
  workspaceId String
  orderAId    String
  orderBId    String
  reasons     Json
  status      ReviewStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime     @default(now())

  @@unique([workspaceId, orderAId, orderBId])
}

/// Gộp đơn/khách có thể tách lại: giữ ảnh chụp bản bị gộp (D-08, data-model quy tắc 6).
model MergeLog {
  id           String    @id @default(cuid())
  workspaceId  String
  entity       String
  survivorId   String
  mergedId     String
  snapshot     Json
  evidence     Json
  mergedById   String
  mergedAt     DateTime  @default(now())
  unmergedAt   DateTime?
  unmergedById String?

  @@index([workspaceId, entity, survivorId])
}

model Payment {
  id          String    @id @default(cuid())
  workspaceId String
  orderId     String
  method      String
  amount      Decimal   @db.Decimal(18, 4)
  currency    String
  status      String
  paidAt      DateTime?
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([workspaceId, paidAt])
}

model Refund {
  id          String   @id @default(cuid())
  workspaceId String
  orderId     String
  amount      Decimal  @db.Decimal(18, 4)
  currency    String
  reason      String?
  refundedAt  DateTime
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([workspaceId, refundedAt])
}

model Shipment {
  id            String            @id @default(cuid())
  workspaceId   String
  orderId       String
  carrier       String?
  trackingNo    String?
  status        FulfillmentStatus
  failureReason String?
  codAmount     Decimal?          @db.Decimal(18, 4)
  deliveredAt   DateTime?
  collectedAt   DateTime?
  /// Lần FAILED gần nhất (dựng lại từ sự kiện mỗi lần nhập). Can thiệp ghi ở DeliveryAction theo đơn + mốc này, vì Shipment bị tạo lại khi nguồn cập nhật.
  failedAt      DateTime?
  order         Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events        DeliveryEvent[]

  @@index([orderId])
  @@index([workspaceId, status, failedAt])
  @@index([workspaceId, collectedAt])
  @@index([workspaceId, trackingNo])
  @@index([trackingNo(ops: raw("gin_trgm_ops"))], type: Gin, map: "Shipment_trackingNo_trgm_idx")
}

model DeliveryEvent {
  id          String            @id @default(cuid())
  workspaceId String
  shipmentId  String
  type        DeliveryEventType
  /// Mã lý do chuẩn hóa (src/modules/fulfillment/reasons.ts); chữ gốc của hãng giữ ở reasonRaw.
  reasonCode  String?
  reasonRaw   String?
  occurredAt  DateTime
  shipment    Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

// ---- Phase 4: nhu cầu mua + không gian sales (thiết kế mục 10 Phase 4) ------------------------------

enum LeadStage {
  MOI
  DANG_TU_VAN
  CHO_QUYET_DINH
  DA_MUA
  TU_CHOI
  MAT_LIEN_LAC
}

/// Nhu cầu mua: một người hỏi mua, có thể chưa có hồ sơ khách (gắn khi SĐT khớp đúng một khách — D-08).
model Lead {
  id                 String       @id @default(cuid())
  workspaceId        String
  customerId         String?
  contactName        String
  contactPhoneE164   String?
  contactEmail       String?
  /// vi | en | ar | de — ngôn ngữ khách dùng, chọn kịch bản theo đây.
  language           String?
  /// Nguồn tiếp cận: inbox, website, quảng cáo, giới thiệu, nhập tay… (chuỗi tự do, D-28).
  source             String
  brandId            String?
  marketId           String?
  /// Sản phẩm quan tâm, văn bản tự do (Phase 10 gắn Variant).
  interest           String?
  budgetAmount       Decimal?     @db.Decimal(18, 4)
  budgetCurrency     String?
  stage              LeadStage    @default(MOI)
  /// Lý do chưa mua / từ chối / mất liên lạc — bắt buộc khi đóng không thành đơn.
  lostReason         String?
  teamId             String?
  ownerId            String?
  /// Hạn phản hồi đầu tiên (Q-23 mặc định 4 giờ từ lúc tạo).
  firstResponseDueAt DateTime?
  firstRespondedAt   DateTime?
  nextActionAt       DateTime?
  closedAt           DateTime?
  /// Tương tác gần nhất (tạo lead, tin/cuộc gọi, ghi chú) — lead mở im lặng quá autoCloseDays thì tự đóng (D-49).
  lastActivityAt     DateTime?
  /// Đã báo quá hạn phản hồi — worker không báo lại mỗi lượt (D-49).
  overdueNotifiedAt  DateTime?
  /// Chống tạo trùng: nguồn gửi lại (mã hội thoại) hoặc bấm hai lần.
  idempotencyKey     String?
  createdById        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  customer           Customer?    @relation(fields: [customerId], references: [id])
  brand              Brand?       @relation(fields: [brandId], references: [id])
  market             Market?      @relation(fields: [marketId], references: [id])
  team               Team?        @relation(fields: [teamId], references: [id])
  owner              User?        @relation("LeadOwner", fields: [ownerId], references: [id])
  assignments        Assignment[]
  activities         Activity[]
  tasks              Task[]

  touchpoints Touchpoint[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, ownerId, stage])
  @@index([workspaceId, teamId, stage])
  @@index([customerId])
  @@index([workspaceId, contactPhoneE164])
  @@index([workspaceId, stage, lastActivityAt])
  @@index([contactName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Lead_contactName_trgm_idx")
}

/// Lịch sử phụ trách (chỉ thêm). byId null = phân công tự động.
model Assignment {
  id          String   @id @default(cuid())
  workspaceId String
  leadId      String
  fromUserId  String?
  toUserId    String?
  teamId      String?
  reason      String
  byId        String?
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id])

  @@index([workspaceId, toUserId, createdAt])
  @@index([leadId])
}

enum ActivityType {
  CALL
  MESSAGE
  MEETING
  NOTE
  /// Đổi giai đoạn, chuyển phụ trách — hệ thống ghi để dòng thời gian đầy đủ.
  SYSTEM
}

enum Direction {
  IN
  OUT
}

model Activity {
  id             String       @id @default(cuid())
  workspaceId    String
  type           ActivityType
  direction      Direction?
  /// Kênh (PHONE, WHATSAPP, MESSENGER, EMAIL…) — chuỗi tự do theo nguồn hội thoại.
  channel        String?
  leadId         String?
  customerId     String?
  /// null = khách hoặc hệ thống.
  actorId        String?
  body           String
  outcome        String?
  durationSec    Int?
  language       String?
  occurredAt     DateTime
  idempotencyKey String?
  createdAt      DateTime     @default(now())
  lead           Lead?        @relation(fields: [leadId], references: [id])
  customer       Customer?    @relation(fields: [customerId], references: [id])
  actor          User?        @relation(fields: [actorId], references: [id])

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, leadId, occurredAt])
  @@index([workspaceId, customerId, occurredAt])
}

enum TaskType {
  CALL_BACK
  FOLLOW_UP
  MEETING
  OTHER
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

model Task {
  id             String     @id @default(cuid())
  workspaceId    String
  type           TaskType
  title          String
  note           String?
  dueAt          DateTime
  status         TaskStatus @default(OPEN)
  assigneeId     String
  leadId         String?
  customerId     String?
  orderId        String?
  ticketId       String?
  createdById    String?
  completedAt    DateTime?
  /// Đã nhắc hạn (worker) — không nhắc lại.
  remindedAt     DateTime?
  idempotencyKey String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  assignee       User       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  lead           Lead?      @relation(fields: [leadId], references: [id])
  customer       Customer?  @relation(fields: [customerId], references: [id])
  order          Order?     @relation(fields: [orderId], references: [id])
  ticket         Ticket?    @relation(fields: [ticketId], references: [id])

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, assigneeId, status, dueAt])
  @@index([leadId])
  @@index([customerId])
  @@index([orderId])
  @@index([workspaceId, status, remindedAt, dueAt])
  @@index([ticketId])
}

/// Kịch bản tư vấn theo brand/market/giai đoạn/ngôn ngữ (null = áp mọi giá trị).
model Script {
  id          String     @id @default(cuid())
  workspaceId String
  brandId     String?
  marketId    String?
  stage       LeadStage?
  language    String
  title       String
  body        String
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  brand       Brand?     @relation(fields: [brandId], references: [id])
  market      Market?    @relation(fields: [marketId], references: [id])
}

enum OutboxStatus {
  /// EXTERNAL_WRITES_ENABLED=false: ghi lại, không gửi (D-13).
  SIMULATED
  /// Chờ adapter gửi thật (Phase 12).
  PENDING
  SENT
  FAILED
}

/// Mọi gửi ra ngoài đi qua đây (thiết kế mục 5 quy tắc 9).
model Outbox {
  id             String       @id @default(cuid())
  workspaceId    String
  channel        String
  recipient      String
  subject        String?
  body           String
  status         OutboxStatus
  entity         String?
  entityId       String?
  idempotencyKey String
  createdAt      DateTime     @default(now())

  @@unique([workspaceId, idempotencyKey])
}

/// Thông báo trong ứng dụng.
model Notification {
  id             String    @id @default(cuid())
  workspaceId    String
  userId         String
  title          String
  body           String?
  link           String?
  readAt         DateTime?
  idempotencyKey String
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, userId, readAt])
}

// ---- Phase 5: dịch vụ sau bán + tri thức (thiết kế mục 10 Phase 5) ---------------------------------

enum TicketType {
  GIAO_CHAM
  LOI_HANG
  DOI_TRA
  BAO_HANH
  KHAC
}

enum TicketPriority {
  THAP
  TRUNG
  CAO
  KHAN
}

enum TicketStatus {
  MOI
  DANG_XU_LY
  CHO_KHACH
  DA_GIAI_QUYET
  DONG
}

/// Chính sách SLA (giờ lịch): theo team + brand (null = mọi brand) + mức. Không có dòng khớp → mặc định trong code (D-50).
model SlaPolicy {
  id                 String         @id @default(cuid())
  workspaceId        String
  brandId            String?
  priority           TicketPriority
  firstResponseHours Float
  resolveHours       Float
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([workspaceId, brandId, priority])
}

model Ticket {
  id                 String         @id @default(cuid())
  workspaceId        String
  /// Mã đọc được, tăng dần trong team (TK-000123).
  code               String
  type               TicketType
  priority           TicketPriority
  status             TicketStatus   @default(MOI)
  subject            String
  customerId         String?
  orderId            String?
  brandId            String?
  teamId             String?
  ownerId            String?
  /// Khách giá trị cao (D-24: ≥ 3 đơn giao thành công 12 tháng) — xếp trước trong hàng đợi.
  vip                Boolean        @default(false)
  firstResponseDueAt DateTime
  resolveDueAt       DateTime
  firstRespondedAt   DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  /// Đã báo sắp quá hạn / quá hạn xử lý — worker không báo lại (D-48).
  dueSoonNotifiedAt  DateTime?
  breachNotifiedAt   DateTime?
  idempotencyKey     String?
  createdById        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  customer           Customer?      @relation(fields: [customerId], references: [id])
  order              Order?         @relation(fields: [orderId], references: [id])
  owner              User?          @relation("TicketOwner", fields: [ownerId], references: [id])
  events             TicketEvent[]
  tasks              Task[]

  @@unique([workspaceId, code])
  @@unique([workspaceId, idempotencyKey])
  @@index([customerId])
  @@index([orderId])
  @@index([workspaceId, ownerId, status])
  @@index([workspaceId, teamId, status])
  @@index([workspaceId, status, resolveDueAt])
  @@index([workspaceId, createdAt])
  @@index([subject(ops: raw("gin_trgm_ops"))], type: Gin, map: "Ticket_subject_trgm_idx")
}

enum TicketEventType {
  CREATED
  /// Khách nhắn thêm sau khi tạo ticket (kênh hội thoại).
  CUSTOMER
  NOTE
  REPLY
  STATUS
  ASSIGN
  PRIORITY
  SYSTEM
}

/// Dòng thời gian ticket (chỉ thêm). REPLY = trả lời khách → Outbox SIMULATED; NOTE = ghi chú nội bộ.
model TicketEvent {
  id             String          @id @default(cuid())
  workspaceId    String
  ticketId       String
  type           TicketEventType
  body           String?
  actorId        String?
  meta           Json?
  idempotencyKey String?
  createdAt      DateTime        @default(now())
  ticket         Ticket          @relation(fields: [ticketId], references: [id])

  @@unique([workspaceId, idempotencyKey])
  @@index([ticketId, createdAt])
}

enum KnowledgeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Bài tri thức theo brand/market/ngôn ngữ (null = áp mọi). Nội dung nằm ở KnowledgeVersion; bài trỏ tới bản đang xuất bản.
model KnowledgeArticle {
  id               String             @id @default(cuid())
  workspaceId      String
  brandId          String?
  marketId         String?
  language         String
  title            String
  status           KnowledgeStatus    @default(DRAFT)
  /// Số phiên bản mới nhất / đang xuất bản (null = chưa xuất bản).
  latestVersion    Int                @default(1)
  publishedVersion Int?
  tags             String[]
  createdById      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  versions         KnowledgeVersion[]

  @@index([workspaceId, status, language])
  @@index([workspaceId, brandId])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "KnowledgeArticle_title_trgm_idx")
}

/// Phiên bản bài tri thức (chỉ thêm) — sửa bài = thêm phiên bản mới; xuất bản = trỏ publishedVersion.
model KnowledgeVersion {
  id          String           @id @default(cuid())
  workspaceId String
  articleId   String
  version     Int
  title       String
  body        String
  createdById String?
  createdAt   DateTime         @default(now())
  article     KnowledgeArticle @relation(fields: [articleId], references: [id])

  @@unique([articleId, version])
}

// ---- Phase 6: chỉ số, chấm điểm, Warehouse (thiết kế mục 10 Phase 6, docs/metrics.md) --------------

/// Từ điển chỉ số (docs/metrics.md). Mã toàn cục, không theo team — một định nghĩa cho cả công ty (L3).
model MetricDefinition {
  code       String   @id
  group      String
  nameVi     String
  nameEn     String
  formula    String
  timeAnchor String
  source     String
  owner      String
  pitfalls   String?
  updatedAt  DateTime @updatedAt
}

/// Chỉ số khách × kỳ do Warehouse dựng (Postgres demo / BigQuery thật). Kỳ "R12M" = 12 tháng trượt tới `asOf`. Tiền quy VND (D-44).
model CustomerMetric {
  id                 String    @id @default(cuid())
  workspaceId        String
  customerId         String
  period             String
  asOf               DateTime
  orders             Int
  deliveredOrders    Int
  failedByCustomer   Int
  confirmedOrders    Int
  rev01              Decimal   @db.Decimal(18, 4)
  rev02              Decimal   @db.Decimal(18, 4)
  rev03              Decimal   @db.Decimal(18, 4)
  rev04              Decimal   @db.Decimal(18, 4)
  refunds            Decimal   @db.Decimal(18, 4)
  /// Lợi nhuận gộp 12 tháng (REV-03 − giá vốn phần đã giao); null khi thiếu giá vốn.
  grossProfit        Decimal?  @db.Decimal(18, 4)
  firstOrderAt       DateTime?
  lastValidOrderAt   DateTime?
  recencyDays        Int?
  /// CUS-02: khoảng cách TB giữa các đơn giao thành công (ngày); null khi < 2 đơn.
  avgCycleDays       Float?
  /// CUS-03: có đơn hợp lệ thứ hai trong 60 ngày sau đơn đầu.
  repurchase60       Boolean   @default(false)
  rScore             Int?
  fScore             Int?
  mScore             Int?
  openTickets        Int       @default(0)
  maxOpenPriority    Int       @default(0)
  oldestOpenTicketAt DateTime?
  /// Số ngày tới lần mua kế tiếp dự kiến = chu kỳ TB − độ gần (âm = đã quá chu kỳ). Null khi < 2 đơn giao. Dùng cho hành trình mua lại (HLD §8.5).
  daysToNextPurchase Float?
  createdAt          DateTime  @default(now())
  customer           Customer  @relation(fields: [customerId], references: [id])

  @@unique([workspaceId, customerId, period])
  @@index([customerId])
  @@index([workspaceId, period, asOf])
  @@index([period, daysToNextPurchase, customerId])
  @@index([period, recencyDays, customerId])
}

enum ScoreType {
  SALES_PRIORITY
  RFM
  TXN_RISK
  SUPPORT_NEED
}

/// Phiên bản trọng số (D-11, D-33): đổi trọng số = phiên bản mới, điểm của phiên bản cũ giữ nguyên.
model ScoreVersion {
  id          String    @id @default(cuid())
  workspaceId String
  type        ScoreType
  version     Int
  weights     Json
  note        String?
  active      Boolean   @default(true)
  createdById String?
  createdAt   DateTime  @default(now())
  scores      Score[]

  @@unique([workspaceId, type, version])
  @@index([workspaceId, type, active])
}

/// Điểm của một khách/lead theo một phiên bản. value null = chưa đủ dữ liệu (không mặc định rủi ro cao — HLD §7.2).
model Score {
  id              String       @id @default(cuid())
  workspaceId     String
  type            ScoreType
  versionId       String
  customerId      String?
  leadId          String?
  value           Int?
  band            String
  /// [{ part, points, max, evidence }]
  reasons         Json
  missingData     String[]
  suggestedAction String?
  computedAt      DateTime
  version         ScoreVersion @relation(fields: [versionId], references: [id])
  customer        Customer?    @relation(fields: [customerId], references: [id])

  @@unique([versionId, customerId])
  @@unique([versionId, leadId])
  @@index([customerId])
  @@index([leadId])
  @@index([workspaceId, type, band])
  @@index([versionId, band, customerId])
}

// ---- Phase 7: điều phối chăm sóc + marketing (thiết kế mục 10 Phase 7, HLD §8.5) --------------------

/// Phân khúc động: điều kiện JSON (cây and/or) dịch sang truy vấn khách (src/modules/marketing/segments.ts). Chạy = lưu ảnh chụp.
model Segment {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  description String?
  rules       Json
  active      Boolean      @default(true)
  lastRunAt   DateTime?
  lastCount   Int?
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  runs        SegmentRun[]
  journeys    Journey[]
  campaigns   Campaign[]

  @@index([workspaceId, active])
}

/// Một lần chạy phân khúc (ảnh chụp điều kiện + số khách). Danh sách khách chỉ giữ cho lần chạy mới nhất (giới hạn dung lượng — D-55).
model SegmentRun {
  id          String          @id @default(cuid())
  workspaceId String
  segmentId   String
  rules       Json
  count       Int
  ms          Int
  ranById     String?
  createdAt   DateTime        @default(now())
  segment     Segment         @relation(fields: [segmentId], references: [id])
  members     SegmentMember[]

  @@index([segmentId, createdAt])
}

model SegmentMember {
  id          String     @id @default(cuid())
  workspaceId String
  runId       String
  customerId  String
  run         SegmentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([runId, customerId])
  @@index([customerId])
}

enum JourneyStatus {
  DRAFT
  ACTIVE
  PAUSED
}

/// Hành trình: khách trong phân khúc được đưa vào; các bước tuyến tính (chờ, điều kiện, gửi tin, tạo việc, gán thẻ, thoát) trong `steps`.
model Journey {
  id            String        @id @default(cuid())
  workspaceId   String
  name          String
  description   String?
  segmentId     String
  brandId       String?
  steps         Json
  /// Điều kiện ra kiểm trước mỗi bước: { purchased, optOut, openTicket } (bật/tắt) + expireDays.
  exitRules     Json
  /// Không đưa lại khách đã ra khỏi hành trình trong N ngày.
  reentryDays   Int           @default(30)
  status        JourneyStatus @default(DRAFT)
  activatedById String?
  activatedAt   DateTime?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  segment       Segment       @relation(fields: [segmentId], references: [id])
  runs          JourneyRun[]
  campaigns     Campaign[]

  @@index([workspaceId, status])
  @@index([segmentId])
}

enum JourneyRunStatus {
  RUNNING
  COMPLETED
  EXITED
}

model JourneyRun {
  id          String           @id @default(cuid())
  workspaceId String
  journeyId   String
  customerId  String
  /// Ngày vào (YYYY-MM-DD) — khóa chống đưa trùng một khách vào cùng hành trình trong cùng ngày khi chạy đồng thời.
  entryKey    String
  status      JourneyRunStatus @default(RUNNING)
  stepIndex   Int              @default(0)
  nextAt      DateTime
  enteredAt   DateTime
  exitedAt    DateTime?
  exitReason  String?
  journey     Journey          @relation(fields: [journeyId], references: [id])
  customer    Customer         @relation(fields: [customerId], references: [id])
  logs        JourneyStepLog[]

  @@unique([journeyId, customerId, entryKey])
  @@index([customerId])
  @@index([workspaceId, status, nextAt])
  @@index([journeyId, status])
}

/// Nhật ký từng bước (chỉ thêm). Khóa (run, bước) làm idempotency: chạy lại không gửi/tạo việc trùng.
model JourneyStepLog {
  id          String     @id @default(cuid())
  workspaceId String
  runId       String
  stepIndex   Int
  stepType    String
  outcome     String
  detail      String?
  createdAt   DateTime   @default(now())
  run         JourneyRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stepIndex])
}

/// Giới hạn liên hệ xuyên chiến dịch (HLD §8.5, Q-24): tối đa maxCount tin/kênh trong windowDays (brandId null = mọi brand).
model ContactCap {
  id          String   @id @default(cuid())
  workspaceId String
  channel     String
  brandId     String?
  maxCount    Int
  windowDays  Int
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, channel, brandId])
}

/// Mỗi lần thật sự liên hệ khách (tin marketing/chăm sóc tự động) — nguồn đếm giới hạn liên hệ, xuyên hành trình/chiến dịch.
model ContactLog {
  id          String   @id @default(cuid())
  workspaceId String
  customerId  String
  channel     String
  brandId     String?
  source      String
  refId       String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, customerId, channel, createdAt])
}

enum CampaignStatus {
  DRAFT
  RUNNING
  ENDED
}

/// Chiến dịch: gom hành trình/phân khúc + nguồn tiếp cận; chi phí nhập tay (nguyên tệ + VND quy đổi — D-44).
model Campaign {
  id           String         @id @default(cuid())
  workspaceId  String
  name         String
  brandId      String?
  segmentId    String?
  journeyId    String?
  channel      String
  utmCampaign  String?
  status       CampaignStatus @default(DRAFT)
  startAt      DateTime?
  endAt        DateTime?
  cost         Decimal?       @db.Decimal(18, 4)
  costCurrency String?
  costBase     Decimal?       @db.Decimal(18, 4)
  createdById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  brand        Brand?         @relation(fields: [brandId], references: [id])
  segment      Segment?       @relation(fields: [segmentId], references: [id])
  journey      Journey?       @relation(fields: [journeyId], references: [id])
  touchpoints  Touchpoint[]

  @@unique([workspaceId, utmCampaign])
  @@index([brandId])
  @@index([segmentId])
  @@index([journeyId])
  @@index([workspaceId, status])
}

/// Điểm chạm: nguồn tiếp cận của khách/lead (UTM), chi phí nhập tay tùy chọn.
model Touchpoint {
  id             String    @id @default(cuid())
  workspaceId    String
  customerId     String?
  leadId         String?
  campaignId     String?
  source         String
  medium         String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  cost           Decimal?  @db.Decimal(18, 4)
  costCurrency   String?
  occurredAt     DateTime
  idempotencyKey String?
  createdAt      DateTime  @default(now())
  customer       Customer? @relation(fields: [customerId], references: [id])
  lead           Lead?     @relation(fields: [leadId], references: [id])
  campaign       Campaign? @relation(fields: [campaignId], references: [id])

  @@unique([workspaceId, idempotencyKey])
  @@index([customerId])
  @@index([leadId])
  @@index([campaignId])
  @@index([workspaceId, occurredAt])
}

// ---- Phase 8: Trung tâm AI ----

enum AgentRunStatus {
  OK
  NEEDS_CLARIFICATION
  DENIED
  ERROR
}

enum ToolCallStatus {
  OK
  DENIED
  ERROR
  PENDING_APPROVAL
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Một lần chạy AI (một yêu cầu của người dùng). Đầu vào đã lọc bí mật/PII ngoài quyền; đầu ra kèm bằng chứng.
model AgentRun {
  id          String         @id @default(cuid())
  workspaceId String
  userId      String
  feature     String
  provider    String
  model       String
  status      AgentRunStatus
  input       String
  output      Json?
  evidence    Json?
  error       String?
  ms          Int
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id])
  toolCalls   ToolCall[]
  suggestions Suggestion[]
  cost        AiCost?

  @@index([workspaceId, createdAt])
  @@index([userId])
  @@index([workspaceId, feature])
}

/// Tool agent gọi — luôn qua service có requirePerm; DENIED khi thiếu quyền (không có tác dụng phụ).
model ToolCall {
  id          String         @id @default(cuid())
  workspaceId String
  runId       String
  tool        String
  args        Json
  status      ToolCallStatus
  result      Json?
  error       String?
  createdAt   DateTime       @default(now())
  run         AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  approval    Approval?

  @@index([runId])
  @@index([workspaceId, status])
}

/// Đề xuất của AI (vd cập nhật nhu cầu mua) — chỉ áp dụng khi người có quyền duyệt.
model Suggestion {
  id          String           @id @default(cuid())
  workspaceId String
  runId       String
  kind        String
  entity      String
  entityId    String
  payload     Json
  reason      String?
  status      SuggestionStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime         @default(now())
  run         AgentRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  approval    Approval?

  @@index([runId])
  @@index([workspaceId, status])
}

/// Hàng chờ duyệt: tool ghi vượt phạm vi / cấu hình cần duyệt, hoặc đề xuất sửa hồ sơ. Người có ai.approve quyết ở /ai.
model Approval {
  id            String         @id @default(cuid())
  workspaceId   String
  toolCallId    String?        @unique
  suggestionId  String?        @unique
  requestedById String
  status        ApprovalStatus @default(PENDING)
  reason        String
  decidedById   String?
  decidedAt     DateTime?
  note          String?
  createdAt     DateTime       @default(now())
  toolCall      ToolCall?      @relation(fields: [toolCallId], references: [id], onDelete: Cascade)
  suggestion    Suggestion?    @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

/// Chi phí một lần chạy (AI-01): token + USD ước tính theo bảng giá cấu hình.
model AiCost {
  id           String   @id @default(cuid())
  workspaceId  String
  runId        String   @unique
  feature      String
  provider     String
  model        String
  inputTokens  Int
  outputTokens Int
  usd          Decimal  @db.Decimal(12, 6)
  createdAt    DateTime @default(now())
  run          AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// ---- Phase 10: vận đơn + đối soát COD (D-58) -------------------------------------------------------

/// Bảng đối soát COD của hãng vận chuyển (một lần "tiền về"), nhập bằng dán dữ liệu. Mốc remitted → CASH-02, REV-04.
model Settlement {
  id          String           @id @default(cuid())
  workspaceId String
  carrier     String
  /// Mã bảng đối soát của hãng (vd số sao kê). Cùng hãng + mã = cùng bảng: dán lại không tạo bảng mới.
  reference   String
  createdById String?
  createdAt   DateTime         @default(now())
  lines       SettlementLine[]

  @@unique([workspaceId, carrier, reference])
  @@index([workspaceId, createdAt])
}

/// Một vận đơn COD đã về tiền. Gắn theo đơn + mã vận đơn (không theo Shipment — Shipment tạo lại khi nguồn cập nhật).
/// Unique (đơn, mã vận đơn): một vận đơn chỉ đối soát một lần, không cộng trùng CASH-02/REV-04.
model SettlementLine {
  id           String     @id @default(cuid())
  workspaceId  String
  settlementId String
  orderId      String
  trackingNo   String
  /// Tiền về (nguyên tệ của đơn). Có thể khác codAmount (hãng trừ phí) — chênh lệch hiện ở trang đối soát.
  amount       Decimal    @db.Decimal(18, 4)
  currency     String
  codAmount    Decimal?   @db.Decimal(18, 4)
  remittedAt   DateTime
  createdAt    DateTime   @default(now())
  settlement   Settlement @relation(fields: [settlementId], references: [id])
  order        Order      @relation(fields: [orderId], references: [id])

  @@unique([workspaceId, orderId, trackingNo])
  @@index([settlementId])
  @@index([orderId])
  @@index([workspaceId, remittedAt])
}

enum DeliveryActionKind {
  REATTEMPT
  CANCEL
  TICKET
}

/// Thao tác xử lý đơn giao thất bại (chỉ thêm). Đơn hết "cần can thiệp" khi có thao tác với failedAt ≥ lần thất bại gần nhất;
/// thất bại lần nữa sau khi giao lại → hiện lại.
model DeliveryAction {
  id             String             @id @default(cuid())
  workspaceId    String
  orderId        String
  kind           DeliveryActionKind
  /// Lần thất bại được xử lý (Shipment.failedAt lúc thao tác).
  failedAt       DateTime
  reasonCode     String?
  note           String?
  ticketId       String?
  idempotencyKey String
  createdById    String
  createdAt      DateTime           @default(now())
  order          Order              @relation(fields: [orderId], references: [id])

  @@unique([workspaceId, idempotencyKey])
  /// Một lần thất bại chỉ xử lý một lần (chặn hai người bấm cùng lúc bằng hai khóa khác nhau).
  @@unique([orderId, failedAt])
  @@index([workspaceId, createdAt])
}
